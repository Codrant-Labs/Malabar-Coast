# Public site URL, without a trailing slash. Set the live canonical domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery fee in pennies (350 = £3.50)
DELIVERY_FEE_PENCE=350
MAX_ORDER_TOTAL_PENCE=100000

# Signed customer order access. Use a random value of at least 32 characters.
ORDER_ACCESS_SECRET=

# Administrator access. Generate the password hash with: pnpm admin:hash -- "your long password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Stripe — use sk_test and whsec test values locally
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worldpay Access Checkout Web SDK v2 and Payments API v6
NEXT_PUBLIC_WORLDPAY_CHECKOUT_ID=
WORLDPAY_ENVIRONMENT=try
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_MERCHANT_ENTITY=
WORLDPAY_NARRATIVE=Malabar Coast
WORLDPAY_WEBHOOK_USERNAME=
WORLDPAY_WEBHOOK_PASSWORD=
# Keep false until the merchant-specific 3DS continuation is tested and approved.
WORLDPAY_CHECKOUT_ENABLED=false

# Durable order storage (required in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
